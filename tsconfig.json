{
  "extends": "./apps/web/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./apps/web",
    "paths": {
      "@/*": ["./src/*"],
      "@/server/*": ["./src/server/*"]
    }
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/web/**/*.mts",
    "apps/web/.next/types/**/*.ts",
    "apps/web/.next/dev/types/**/*.ts"
  ],
  "exclude": [
    "apps/web/node_modules",
    "apps/web/**/*.test.ts",
    "apps/web/vitest.config.ts",
    "archive",
    "server",
    "client"
  ]
}
